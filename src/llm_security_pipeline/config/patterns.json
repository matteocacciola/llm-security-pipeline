{
  "_comment": "Default detection patterns for output_guard.py. This file can be pointed to directly, or extended/overridden by passing an additional custom config file path to PatternRegistry.load(). Entries in a custom file with the same 'name' override the corresponding default entry; new names are added alongside the defaults. Supported flags: IGNORECASE, MULTILINE, DOTALL.",

  "secret_patterns": [
    {
      "name": "openai_api_key",
      "pattern": "\\bsk-[A-Za-z0-9]{20,}\\b",
      "flags": []
    },
    {
      "name": "anthropic_api_key",
      "pattern": "\\bsk-ant-[A-Za-z0-9\\-_]{20,}\\b",
      "flags": []
    },
    {
      "name": "aws_access_key",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
      "flags": []
    },
    {
      "name": "generic_bearer_token",
      "pattern": "\\bBearer\\s+[A-Za-z0-9\\-_.=]{20,}\\b",
      "flags": ["IGNORECASE"]
    },
    {
      "name": "private_key_block",
      "pattern": "-----BEGIN (RSA |EC )?PRIVATE KEY-----",
      "flags": []
    },
    {
      "name": "generic_high_entropy_secret",
      "pattern": "\\b(?=[A-Za-z0-9+/=]{32,}\\b)(?=.*[A-Z])(?=.*[0-9])[A-Za-z0-9+/=]{32,}\\b",
      "flags": []
    }
  ],

  "pii_patterns": [
    {
      "name": "email",
      "pattern": "\\b[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}\\b",
      "flags": []
    },
    {
      "name": "it_codice_fiscale",
      "pattern": "\\b[A-Z]{6}\\d{2}[A-EHLMPR-T]\\d{2}[A-Z]\\d{3}[A-Z]\\b",
      "flags": []
    }
  ],

  "injection_patterns": [
